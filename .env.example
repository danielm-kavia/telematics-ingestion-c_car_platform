BACKEND_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3000
WS_URL=ws://localhost:3002/ws
SITE_URL=http://localhost:3000

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_MAX_AGE=3600

COOKIE_DOMAIN=localhost
TRUST_PROXY=true
HOST=0.0.0.0
NODE_ENV=development

REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_MAX=100

# Service port (preview systems may map this)
PORT=3002

# Logging
SERVICE_NAME=telematics-ingestion
LOG_LEVEL=info

# Optional simple shared-secret for ingest endpoints (leave empty to disable auth)
# Use: Authorization: Bearer <INGEST_AUTH_TOKEN>
INGEST_AUTH_TOKEN=

# --- Kafka (optional in Phase 3 MVP) ---
# If KAFKA_ENABLED=true, service will run a consumer that reads telematics messages and persists them to TimescaleDB.
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=telematics-ingestion
KAFKA_CONSUMER_GROUP_ID=telematics-ingestion-v1
KAFKA_TOPIC_TELEMATICS=telematics.v1

# --- TimescaleDB (optional in Phase 3 MVP) ---
# If TIMESCALE_ENABLED=true, service will connect and ensure:
# - telematics_readings table exists
# - hypertable is created when TimescaleDB extension is available
TIMESCALE_ENABLED=false
# Prefer TIMESCALE_DATABASE_URL; DATABASE_URL is accepted as a fallback.
# Example local dev:
# TIMESCALE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telematics
TIMESCALE_DATABASE_URL=
TIMESCALE_SCHEMA=public
TIMESCALE_TABLE=telematics_readings
